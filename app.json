{
  "expo": {
    "name": "Amano",
    "slug": "amano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F6F9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.m.omlil.fintechmobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.m.omlil.fintechmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "45b387da-bda2-40fb-aa32-a1eb600cb84c"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-font"
    ],
    "owner": "mylegal-01"
  }
}
